# Copy to `.env` and fill in. `.env` is git-ignored: never commit real tokens.
# The DagsHub token is created at https://dagshub.com/user/settings/tokens

DAGSHUB_USER=your-dagshub-username
DAGSHUB_REPO=brain-tumor-mlops
DAGSHUB_TOKEN=your-dagshub-token

# MLflow tracking server hosted by DagsHub.
# Empty MLFLOW_TRACKING_URI = log to a local SQLite file (./mlflow.db).
# Once your DagsHub credentials are filled in, uncomment the three lines below.
MLFLOW_TRACKING_URI=
# MLFLOW_TRACKING_URI=https://dagshub.com/your-dagshub-username/brain-tumor-mlops.mlflow
# MLFLOW_TRACKING_USERNAME=your-dagshub-username
# MLFLOW_TRACKING_PASSWORD=your-dagshub-token

# Serving: path to the checkpoint loaded by the API / demo.
MODEL_CHECKPOINT=models/best.pt
